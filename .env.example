# OMV — variáveis de ambiente. Copie para .env e ajuste. NUNCA versione o .env.
DATABASE_URL=postgres://omv:omv@localhost:5432/omv
DATABASE_URL_TESTE=postgres://omv:omv@localhost:5432/omv_test
DATABASE_URL_UNIT=postgres://omv:omv@localhost:5432/omv_test_unit

# Chave de 32 bytes em base64 (openssl rand -base64 32). Cifra segredos MFA e anexos temporários.
OMV_CHAVE_CIFRA=
# Segredo para HMAC de tokens/cookies auxiliares (openssl rand -base64 32).
OMV_SEGREDO_APP=

# URL pública do sistema (usada em links de e-mail e cookies Secure).
OMV_URL_PUBLICA=http://localhost:3000

# Modo demonstração: exibe dados FICTÍCIOS (faixa "DEMONSTRAÇÃO" em toda tela). Nunca em produção.
OMV_MODO_DEMO=false

# E-mail transacional (provedor a definir). Sem SMTP, links de redefinição vão para o log do servidor (apenas dev).
SMTP_URL=
SMTP_REMETENTE=nao-responda@exemplo.invalid

# Sessão
OMV_SESSAO_OCIOSA_MIN=30
OMV_SESSAO_ABSOLUTA_H=12

# Origens extras permitidas para Server Actions atrás de proxy (separadas por vírgula; ex.: omv.exemplo.gov.br). No GitHub Codespaces já é automático.
OMV_ORIGENS_PERMITIDAS=
